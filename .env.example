# ========================================================
# AI-Powered Fake News Detection & Verification System
# Environment Configuration Template
# NOTE: Do NOT commit actual API keys to version control!
# ========================================================

# OpenAI API Key (Optional for LLM analysis; if omitted, local semantic reasoning is used)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (defaults to gpt-4o-mini if not specified)
OPENAI_MODEL=gpt-4o-mini

# Optional Custom LLM Base URL (for Ollama, vLLM, or Azure OpenAI)
# OPENAI_BASE_URL=http://localhost:11434/v1

# Python Flask Backend Port
FLASK_PORT=5000

# Next.js Server API Proxy Target (if using separate Flask microservice)
NEXT_PUBLIC_FLASK_API_URL=http://127.0.0.1:5000
